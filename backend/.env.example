# Database Settings
# Leave commented to use the default SQLite database (portfolio.db)
# Or set for PostgreSQL:
# PORTFOLIO_DB_URL=postgresql://portfolio:portfolio_password@db:5432/portfolio_db

# Security & Encryption (REQUIRED: generate via Fernet.generate_key())
ENCRYPTION_KEY=wJrDW3SF-dzE7d-iUJfjSEENNR5BRGG_0L0twcPfJO8=
SECRET_KEY=your_super_secret_jwt_key_here

# Email Settings (Required for Registration OTP & MFA; falls back to terminal OTP if empty)
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME="SPAIE"

# Google SSO (Required for "Sign in with Google")
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Redis & Celery (Configured automatically in Docker Compose)
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS allowed origins (optional, comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000
