# ===========================================================
# Portfolio Engine Environment Variables
# ===========================================================

# --- Security ---
ENCRYPTION_KEY=wJrDW3SF-dzE7d-iUJfjSEENNR5BRGG_0L0twcPfJO8=
SECRET_KEY=your_super_secret_jwt_key_here

# --- Google SSO (Frontend & Backend) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Email Settings (Registration & MFA) ---
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_email@example.com
SMTP_PASSWORD=your_brevo_smtp_password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME="SPAIE"

# --- Database ---
# Default is SQLite (local portfolio.db). To use PostgreSQL service in Docker:
# PORTFOLIO_DB_URL=postgresql://portfolio:portfolio_password@db:5432/portfolio_db

# --- Redis & Celery (handled automatically in Docker Compose) ---
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
